# Enables migrated Recruitment routes for design review without changing the
# backend-controlled production rollout. Authentication and API authorization
# continue to apply.
NEXT_PUBLIC_RECRUITMENT_DESIGN_PREVIEW=false

# Shows clearly labelled local prototype updates when public Stories are empty.
# Production should leave this false and display only API-backed public content.
NEXT_PUBLIC_DESIGN_CONTENT_PREVIEW=false

# Google Identity Services client id (public by OAuth design — safe in browser
# JS). Same value as backend/.env's GOOGLE_CLIENT_ID; see TESTING-SERVER.md.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

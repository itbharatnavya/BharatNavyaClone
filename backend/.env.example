# ─────────────────────────────────────────────────────────────
# BharatSource backend — environment template
# Copy to `.env` and fill in. `.env` is gitignored (see SECURITY.md).
#   cp backend/.env.example backend/.env
# ─────────────────────────────────────────────────────────────

# Port the Express API listens on.
PORT=4000

# ── Auth ──────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. The server refuses to boot in production if this
# is unset. Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Admin bootstrap ───────────────────────────────────────────
# Password used when the admin account is (re)seeded. If unset, the seed
# generates a random one and prints it ONCE. Never hardcode a weak value.
ADMIN_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────
# Origin allowed to call the API directly (only needed if the UI is hosted
# on a DIFFERENT origin than the API; the default single-origin proxy setup
# does not need this).
CORS_ORIGIN=http://localhost:3000

# ── AI concierge ──────────────────────────────────────────────
# BharatSource's AI search/RFQ runs through the local `claude` CLI (the
# machine must be logged into a Claude Code subscription) — NOT an API key.
# Leave ANTHROPIC_API_KEY unset unless you deliberately switch to the API.
# ANTHROPIC_API_KEY=

# ── Storage backend ────────────────────────────────────────────
# Leave unset to use the default file-based store (backend/DB/*.json). Setting this
# switches lib/store.js to lib/pg-store.js (Postgres) — see scripts/migrate-all.js.
# PG_URL=postgres://user:password@localhost:5432/bharatsource

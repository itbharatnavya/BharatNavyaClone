# ─────────────────────────────────────────────────────────────
# BharatSource backend — environment template
# Copy to `.env` and fill in. `.env` is gitignored (see SECURITY.md).
#   cp backend/.env.example backend/.env
# ─────────────────────────────────────────────────────────────

# Port the Express API listens on.
PORT=4000

# Log level (lib/logger.js): trace|debug|info|warn|error|fatal|silent.
# Default: debug in development, info in production, silent under NODE_ENV=test.
# LOG_LEVEL=info

# ── Auth ──────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. The server refuses to boot in production if this
# is unset. Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Admin bootstrap ───────────────────────────────────────────
# Password used when the admin account is (re)seeded. If unset, the seed
# generates a random one and prints it ONCE. Never hardcode a weak value.
ADMIN_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────
# Origin allowed to call the API directly (only needed if the UI is hosted
# on a DIFFERENT origin than the API; the default single-origin proxy setup
# does not need this).
CORS_ORIGIN=http://localhost:3000

# ── AI concierge ──────────────────────────────────────────────
# BharatSource's AI search/RFQ runs through the local `claude` CLI (the
# machine must be logged into a Claude Code subscription) — NOT an API key.
# Leave ANTHROPIC_API_KEY unset unless you deliberately switch to the API.
# ANTHROPIC_API_KEY=

# ── Storage backend ────────────────────────────────────────────
# Leave unset to use the default file-based store (backend/DB/*.json). Setting this
# switches lib/store.js to lib/pg-store.js (Postgres) — see scripts/migrate-all.js.
# PG_URL=postgres://user:password@localhost:5432/bharatsource
# Set PG_SSL=true for a managed Postgres that requires TLS (most cloud providers).
# PG_SSL=false
# Pool hardening — safe defaults; only override to tune (values in ms).
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_CONNECT_TIMEOUT_MS=5000
# PG_IDLE_TIMEOUT_MS=30000
# Dedicated database for `npm test` (used only when NODE_ENV=test, which test/_env.js
# sets). Build/refresh it with `npm run test:setup`. Unset → tests fall back to PG_URL.
# PG_URL_TEST=postgres://user:password@localhost:5432/bharatsource_test

# ── Rate limiting (lib/security.js) ───────────────────────────
# All limiters return HTTP 429 {success:false,error,code:"rate_limited"}.
# Set RATE_LIMIT_ENABLED=false to switch every limiter off (the test suite does this).
# RATE_LIMIT_ENABLED=true
# RL_GLOBAL_MAX=1000     # requests / 15 min across the whole API (coarse DoS guard)
# RL_AUTH_MAX=10         # /api/auth/* per 15 min, keyed on IP + mobile/email
# AGENT_AI_PER_HOUR=40   # Ask Navya agent: max claude-CLI answers/hour across ALL users (over it -> answers from in-app data only)
# RL_AI_MAX=30           # /api/ai/* + /api/assistant/* per hour, keyed on user id / IP
# AI_PROMPT_MAX=4000     # max chars for a free-text AI prompt (need / query / message)

# ── File uploads (résumés, photos, ad creatives, logos) ────────
# "local" (default) writes into frontend/public/uploads/ — zero setup, fine for dev.
# Set to "s3" on a production move; no code change needed, just these env vars —
# see HANDOVER.md "File storage" for the full switch-over checklist.
UPLOAD_STORAGE=local
# Required when UPLOAD_STORAGE=s3:
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=bharatsource-uploads
# Optional — omit to use the AWS SDK's default credential chain (IAM role), the
# recommended production setup. Only set these for local testing against a real bucket.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional — a CloudFront (or other CDN) domain in front of the bucket. When set,
# uploaded-file URLs use this instead of the raw *.s3.amazonaws.com host.
# S3_PUBLIC_BASE_URL=https://cdn.bharatsource.in

# ── OTP echo (no SMS gateway yet) ───────────────────────────────
# When true, POST /api/auth/send-otp returns the OTP in the response so the login
# page can show it. Dev does this automatically. Set ONLY on the non-prod testing
# deployment — never production (it bypasses the OTP).
# OTP_ECHO=true

# ── Social login (Google) ───────────────────────────────────────
# POST /api/auth/oauth/google. Leave unset to keep the route disabled (503) —
# safe default for dev without a Google Cloud account yet. Free, no card needed:
# console.cloud.google.com → OAuth consent screen (External, add yourself as a
# test user) → Credentials → Create Credentials → OAuth client ID → Web
# application. Use a SEPARATE client id per environment (dev/staging/prod) and
# put each environment's value only in that environment's own .env.
# GOOGLE_CLIENT_ID=
# Facebook and Apple social login are not implemented yet (Apple requires a
# paid $99/yr Apple Developer account before any key can even be generated).

# ── Recruitment go-live gate ────────────────────────────────────
# Recruitment is built but stays behind a "Coming soon" page until this is set.
# Leave unset to control it from the admin panel instead (Site Config →
# featureFlags.recruitmentLive) — this env var, when set, OVERRIDES that admin value.
# RECRUITMENT_LIVE=true

# ── FCM push (Firebase Cloud Messaging) ─────────────────────────
# Delivers a "new_message" chat notification even when the tab/browser is
# closed (Socket.IO, always-on, only reaches an open tab). Leave unset to keep
# push disabled — chat/notifications work fine without it (lib/fcm.js no-ops).
# 1. console.firebase.google.com → create a project → Project settings →
#    Service accounts → Generate new private key → downloads a JSON file.
# 2. Put that JSON file somewhere NEVER committed — this repo's convention is
#    backend/private/ (gitignored). NEVER put the file itself, or its contents,
#    directly in this .env file or anywhere that gets committed.
# 3. Point this at that file's path (absolute, or relative to backend/):
# FCM_SERVICE_ACCOUNT_PATH=./private/<your-project>-firebase-adminsdk-xxxxx.json
# See CHAT-PLAN.md "Phase 10 — FCM push" for the full setup + what this wires into.

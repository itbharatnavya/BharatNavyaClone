{
  "name": "bharatsource-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BharatSource API — Express + JSON file storage",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "setup-pg-schema": "node scripts/setup-pg-schema.js",
    "migrate-all": "node scripts/migrate-all.js",
    "migrate-schema": "node scripts/migrate-schema.js",
    "migrate-schema:status": "node scripts/migrate-schema.js --status",
    "seed-recruitment-demo": "node scripts/seed-recruitment-demo.js",
    "seed-demo-stories": "node scripts/seed-demo-stories.js",
    "test:setup": "node scripts/setup-test-db.js",
    "test": "node --test --test-concurrency=1 --require ./test/_env.js test/*.test.js",
    "test:goldens": "node --test --test-concurrency=1 --require ./test/_env.js test/golden.test.js",
    "goldens:update": "node scripts/update-goldens.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "minisearch": "^7.2.0",
    "pg": "^8.11.0",
    "pino": "^9.14.0",
    "proper-lockfile": "^4.1.2",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
